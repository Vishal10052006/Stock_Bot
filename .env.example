# STOCK_BOT M20 — real-market SHADOW runtime
#
# NEVER put a real access token in Git.
# Copy this file to .env locally. .env is ignored.

STOCK_BOT_MODE=SHADOW
STOCK_BOT_LIVE_ORDER_SUBMISSION=false

# Upstox market-data credentials/configuration.
UPSTOX_ACCESS_TOKEN=
UPSTOX_FEED_MODE=ltpc
UPSTOX_FEED_TIMEOUT_SECONDS=10
UPSTOX_RECONNECT_MAX_ATTEMPTS=3
UPSTOX_RECONNECT_DELAY_SECONDS=1

# JSON mapping of internal symbols to Upstox NSE_EQ instrument keys.
# Example:
# UPSTOX_INSTRUMENT_MAP={"RELIANCE":"NSE_EQ|<ISIN>","TCS":"NSE_EQ|<ISIN>"}
UPSTOX_INSTRUMENT_MAP=

# Optional runtime controls.
STOCK_BOT_SYMBOLS=
STOCK_BOT_MAX_CANDLES=1
STOCK_BOT_EVENT_MAX_AGE_SECONDS=5
STOCK_BOT_EVENT_MAX_FUTURE_SKEW_SECONDS=2
STOCK_BOT_CANDLE_TIMEFRAME_MINUTES=5

# Optional append-only M20 shadow session evidence journal.
# Leave unset to keep the runtime journal disabled.
STOCK_BOT_SHADOW_JOURNAL=
STOCK_BOT_SHADOW_SESSION_ID=

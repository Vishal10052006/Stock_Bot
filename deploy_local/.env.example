# Local STOCK_BOT runtime template. Never commit populated secrets.
UPSTOX_ACCESS_TOKEN=
UPSTOX_FEED_MODE=ltpc
UPSTOX_FEED_TIMEOUT_SECONDS=10
UPSTOX_RECONNECT_MAX_ATTEMPTS=5
UPSTOX_RECONNECT_DELAY_SECONDS=2
UPSTOX_INSTRUMENT_MAP=
UPSTOX_CONTEXT_INSTRUMENT_MAP=
STOCK_BOT_RESEARCH_RSS_URLS={}
STOCK_BOT_RUNTIME_ROOT=.stock_bot_runtime
STOCK_BOT_DASHBOARD_HOST=127.0.0.1
STOCK_BOT_DASHBOARD_PORT=8765
STOCK_BOT_SYMBOL=RELIANCE
STOCK_BOT_BENCHMARK=NIFTY50
STOCK_BOT_MODEL_ARTIFACT=
STOCK_BOT_MODEL_SHA256=
STOCK_BOT_SESSION_ID=LOCAL-PAPER
STOCK_BOT_LIVE_BROKER_ENABLED=false
